# @angular/fire's latest stable release (20.x) only declares peer dependency
# support for Angular 20. Angular itself has moved on to 22, and @angular/fire
# has no stable release for anything past 20 yet (only a 21 release candidate,
# nothing for 22). Until @angular/fire ships a release compatible with the
# Angular version in this project, npm's strict peer dependency resolution
# will fail installs with an ERESOLVE conflict, so relax it here.
legacy-peer-deps=true
